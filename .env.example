# Vercel Postgres / Prisma Postgres Environment Variables
DATABASE_URL="postgresql://user:password@localhost:5432/needle_collection?schema=public"
DATABASE_URL_POOLED="postgresql://user:password@localhost:5432/needle_collection?pgbouncer=true"
POSTGRES_URL="postgresql://user:password@localhost:5432/needle_collection"
PRISMA_DATABASE_URL="postgresql://user:password@localhost:5432/needle_collection"

# Secret for signing admin JWT tokens
JWT_SECRET="needle-collection-super-secret-jwt-key-2026"

# Default Admin Credentials (used on initial seed)
